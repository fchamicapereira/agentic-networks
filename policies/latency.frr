! Latency-aware routing policy.
!
! Assigns each neighbor a BGP weight inversely proportional to its direct link
! delay: weight = round(1000 / delay_ms). BGP always prefers higher weight, so
! fast links win over slow ones in path selection.
!
! This causes nodes to avoid expensive direct links when a multi-hop path via
! faster links is available. For example, on full_mesh_4:
!
!   A→C direct:        170ms  (weight 6)
!   A→B→C via B:    10+15=25ms  (weight 100 then 67)
!   A→D→C via D:     5+25=30ms  (weight 200 then 40)
!
! Template variables substituted per-node at startup:
!   __ASN__              - this node's BGP AS number
!   __NEIGHBOR_WEIGHTS__ - "neighbor <ip> weight <w>" lines for each peer
!
router bgp __ASN__
__NEIGHBOR_WEIGHTS__
 bgp always-compare-med
 bgp bestpath compare-routerid
 address-family ipv4 unicast
  maximum-paths 8
 exit-address-family
!
