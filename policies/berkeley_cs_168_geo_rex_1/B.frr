! B.frr — Peer of S, provider of D
!
! Relationships (Gao-Rexford):
!   Peers:     S (10.0.2.1)
!   Customers: D (10.0.5.2)
!
! B and S exchange traffic settlement-free (peer relation).
! D pays B for transit — B provides D global reachability.
!
! Local preference:
!   300 = customer-learned
!   200 = peer-learned
!
! Export policy (valley-free routing):
!   → peers:     own prefix + customer routes only (no re-exporting peer routes)
!   → customers: full table

bgp community-list standard CUSTOMER-ROUTES permit 65002:100
!
ip prefix-list OWN-PREFIX seq 5 permit 10.255.2.1/32
!
route-map FROM-PEER permit 10
 set community 65002:200
 set local-preference 200
!
route-map FROM-CUSTOMER permit 10
 set community 65002:100
 set local-preference 300
!
! To peers: only own prefix and customer-learned routes (valley-free).
route-map TO-PEER permit 10
 match ip address prefix-list OWN-PREFIX
route-map TO-PEER permit 20
 match community CUSTOMER-ROUTES
route-map TO-PEER deny 30
!
route-map TO-CUSTOMER permit 10
!
router bgp __ASN__
 address-family ipv4 unicast
  ! Peer
  neighbor 10.0.2.1 route-map FROM-PEER in
  neighbor 10.0.2.1 route-map TO-PEER out
  ! Customer
  neighbor 10.0.5.2 route-map FROM-CUSTOMER in
  neighbor 10.0.5.2 route-map TO-CUSTOMER out
 exit-address-family
!
