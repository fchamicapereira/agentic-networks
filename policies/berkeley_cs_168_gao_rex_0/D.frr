! D.frr — Stub AS with three providers
!
! Relationships (Gao-Rexford):
!   Providers: A (10.0.4.1), B (10.0.5.1), C (10.0.6.1)
!
! D is a pure stub: it originates only its own prefix and does not transit
! traffic for anyone. It has three providers for redundancy.
! All providers receive equal local-preference (D has no economic reason to prefer
! one over another — any will do for global reachability).
!
! Local preference:
!   100 = provider-learned
!
! Export policy:
!   → providers: own prefix only (D does not provide transit)

ip prefix-list OWN-PREFIX seq 5 permit 10.255.4.1/32
!
route-map FROM-PROVIDER permit 10
 set local-preference 100
!
! Only advertise D's own prefix upstream — D is a stub, not a transit AS.
route-map TO-PROVIDER permit 10
 match ip address prefix-list OWN-PREFIX
route-map TO-PROVIDER deny 20
!
router bgp __ASN__
 address-family ipv4 unicast
  neighbor 10.0.4.1 route-map FROM-PROVIDER in
  neighbor 10.0.4.1 route-map TO-PROVIDER out
  neighbor 10.0.5.1 route-map FROM-PROVIDER in
  neighbor 10.0.5.1 route-map TO-PROVIDER out
  neighbor 10.0.6.1 route-map FROM-PROVIDER in
  neighbor 10.0.6.1 route-map TO-PROVIDER out
 exit-address-family
!
