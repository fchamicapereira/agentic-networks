# Citation metadata for this repository. GitHub reads this file to render the
# "Cite this repository" button.
#
# PLACEHOLDER — the paper is accepted at HotNets 2026 but the camera-ready is not out
# yet. Once it is published, fill in under `preferred-citation`:
#
#   collection-title  exact proceedings title (e.g. "Proceedings of the Nth ACM
#                     Workshop on Hot Topics in Networks")
#   doi               ACM DOI for the paper
#   start / end       page numbers
#   month             month of publication
#   publisher         "Association for Computing Machinery"
#   conference        location and dates of the workshop

cff-version: 1.2.0
title: Instantiating the Knowledge Plane
message: >-
  If you use this software or its experimental data, please cite the
  accompanying paper.
type: software
license: MIT
repository-code: https://github.com/fchamicapereira/agentic-networks
abstract: >-
  An emulated interdomain network in which LLM agents act as autonomous system
  administrators, one per network entity, collaborating across organizational
  boundaries to diagnose faults, reason about misleading routing announcements,
  and make policy-driven routing decisions. Includes the emulation harness, agent
  prompts, topologies, and complete logs for every experiment in the paper.
keywords:
  - knowledge plane
  - interdomain routing
  - network management
  - large language models
  - multi-agent systems
authors:
  - given-names: Francisco
    family-names: Pereira
    affiliation: INESC-ID, Instituto Superior Técnico, University of Lisbon
  - given-names: Pratiksha
    family-names: Thaker
    affiliation: Databricks
  - given-names: Justine
    family-names: Sherry
    affiliation: Carnegie Mellon University

preferred-citation:
  type: conference-paper
  title: Instantiating the Knowledge Plane
  year: 2026
  authors:
    - given-names: Francisco
      family-names: Pereira
      affiliation: INESC-ID, Instituto Superior Técnico, University of Lisbon
    - given-names: Pratiksha
