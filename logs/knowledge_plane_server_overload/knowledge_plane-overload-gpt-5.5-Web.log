#!/usr/bin/env python3
import http.server
import socketserver
import ssl
import threading
import time
from pathlib import Path

BIND_IP = "198.82.0.1"
PORT_HTTP = 80
PORT_HTTPS = 443
MAX_WORKERS = 3
SLOW_HOLD_SECONDS = 90

_ASSETS = Path(__file__).parent
CERT_FILE = str(_ASSETS / "acm-server.crt")
KEY_FILE  = str(_ASSETS / "acm-server.key")

_sem = threading.Semaphore(MAX_WORKERS)

_OK_BODY = b"""\
