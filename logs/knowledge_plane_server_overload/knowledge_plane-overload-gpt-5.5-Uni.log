python3 - <<'PY'
import socket, ssl, time, re, datetime
host='acm.org'; ip='198.82.0.1'
for scheme,port,tls in [('http',80,False),('https',443,True)]:
    t0=time.time()
    s=socket.create_connection((ip,port),timeout=5)
    local=s.getsockname()[0]
    if tls:
        ctx=ssl.create_default_context()
        s=ctx.wrap_socket(s,server_hostname=host)
    req=f'GET / HTTP/1.1\r\nHost: {host}\r\nUser-Agent: KP-Uni-AS1-requested-retest/1.0\r\nConnection: close\r\n\r\n'.encode()
    s.sendall(req)
    data=b''
    while True:
        chunk=s.recv(4096)
        if not chunk: break
        data += chunk
    elapsed=time.time()-t0
    text=data.decode(errors='replace')
    head, _, body = text.partition('\r\n\r\n')
    lines=head.split('\r\n')
    status=lines[0] if lines else ''
    server=next((l for l in lines if l.lower().startswith('server:')), 'Server: <absent>')
    title_match=re.search(r'<title>(.*?)</title>', body, re.I|re.S)
    title=' '.join(title_match.group(1).split()) if title_match else '<none>'
    first_body=' '.join(re.sub('<[^>]+>',' ',body).split())[:160]
    print(f'{scheme.upper()} timestamp_utc={datetime.datetime.utcnow().replace(microsecond=0).isoformat()}Z source={local} remote={ip}:{port} elapsed={elapsed:.3f}s')
    print(f'{scheme.upper()} status_line={status}')
    print(f'{scheme.upper()} {server}')
    print(f'{scheme.upper()} title={title}')
    print(f'{scheme.upper()} first_body_text={first_body}')
    s.close()
PY
